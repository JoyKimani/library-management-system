{
  "info": {
    "name": "Library Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"librarian@example.com\",\n  \"password\": \"password123\"\n}" }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"librarian@example.com\",\n  \"password\": \"password123\"\n}" }
          }
        },
        {
          "name": "User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/users/profile"
          }
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        { "name": "Create Genre", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/genres", "body": { "mode": "raw", "raw": "{\n  \"name\": \"History\",\n  \"slug\": \"history\"\n}" } } },
        { "name": "Get All Genres", "request": { "method": "GET", "url": "{{baseUrl}}/genres" } },
        { "name": "Get Genre", "request": { "method": "GET", "url": "{{baseUrl}}/genres/1" } },
        { "name": "Update Genre", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/genres/1", "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated History\"\n}" } } },
        { "name": "Delete Genre", "request": { "method": "DELETE", "url": "{{baseUrl}}/genres/1" } }
      ]
    },
    {
      "name": "Books",
      "item": [
        { "name": "Filter and Paginate Books", "request": { "method": "GET", "url": "{{baseUrl}}/books?genreId=1&search=dune&page=1&limit=10" } },
        { "name": "Get Book", "request": { "method": "GET", "url": "{{baseUrl}}/books/1" } },
        { "name": "Create Book", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/books", "body": { "mode": "raw", "raw": "{\n  \"title\": \"Sample Book\",\n  \"author\": \"Sample Author\",\n  \"isbn\": \"9780000000001\",\n  \"totalCopies\": 3,\n  \"genreId\": 1\n}" } } },
        { "name": "Update Book", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/books/1", "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated Title\"\n}" } } },
        { "name": "Delete Book", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/books/1" } }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" }
  ]
}
